# Copie este arquivo para .env e preencha se quiser conectar um Supabase
# próprio. NENHUMA dessas variáveis é necessária para rodar o dashboard: os
# dados do case (síntéticos) já vêm embutidos em src/lib/novara/facts.ts.
# .env já está no .gitignore — nunca commitar chaves reais.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
